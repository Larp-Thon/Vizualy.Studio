---
import WorkLayout from '../layouts/WorkLayout.astro';

const videoEntries = import.meta.glob('/public/videos/*.{mp4,MP4,webm,WEBM,ogg,OGG}', { eager: true });

const normalizeTitle = (filename: string) =>
	filename
		.replace(/\.(mp4|webm|ogg)$/i, '')
		.replace(/[_.-]+/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();

const normalizeMatchText = (text: string) =>
	text
		.toLowerCase()
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '');

const getCategory = (title: string) => {
	const value = normalizeMatchText(title);

	if (/empresa|empresarial|comercio|feria|marca|benigna|dorado|restaurante|tokyo|amare/.test(value)) return 'Empresarial';
	if (/quince|15 años|15 anos|cumpleaños/.test(value)) return 'Quinceaños';
	if (/bauti|batizo|bautizo/.test(value)) return 'Bautizo';
	if (/boda|novios|reel|wedding|dan|vivian/.test(value)) return 'Boda';

	return 'Evento';
};

const getMimeType = (filename: string) => {
	const extension = filename.toLowerCase().split('.').pop();

	if (extension === 'webm') return 'video/webm';
	if (extension === 'ogg') return 'video/ogg';

	return 'video/mp4';
};

const videos = Object.entries(videoEntries)
	.map(([path]) => {
		const filename = path.split('/').pop() || '';
		const title = normalizeTitle(filename) || filename;

		return {
			src: path.replace('/public', ''),
			title,
			type: getMimeType(filename),
			category: getCategory(title),
		};
	})
	.sort((a, b) => a.title.localeCompare(b.title, 'es'));

const featuredVideo = videos.find((video) => /reel|final/i.test(video.title)) ?? videos[0];
const secondaryVideos = videos.filter((video) => video !== featuredVideo);
const heroLoopVideo = videos.find((video) => /camara de comercio/i.test(video.title)) ?? featuredVideo;
---

<WorkLayout
	title="Videos - Vizualy.Studio"
	heroImage="/eventos/IMG_7968.webp"
	heroAlt="Producción audiovisual de Vizualy"
	heroText="Videos"
	heroSubtext="Una selección de piezas audiovisuales para bodas, marcas y eventos"
	heroVideo={heroLoopVideo?.src}
>
	<section class="mx-auto max-w-7xl px-6 pb-10 pt-20 sm:px-10 lg:px-12" data-reveal-item>
		{featuredVideo ? (
			<div class="grid gap-6 lg:grid-cols-12 lg:items-stretch">
				<article class="overflow-hidden rounded-4xl border border-white/10 bg-white/5 shadow-2xl shadow-black/30 lg:col-span-8">
					<div class="group relative">
						<video
							id="video-featured"
							class="aspect-video h-full w-full object-cover"
							preload="metadata"
							playsinline
							aria-label={featuredVideo.title}
							data-fullscreen-video
						>
							<source src={featuredVideo.src} type={featuredVideo.type} />
							Tu navegador no soporta video HTML5.
						</video>
						<button
							type="button"
							class="absolute inset-0 z-10 flex items-center justify-center bg-black/35 p-4 text-center text-sm font-semibold text-white/90 transition group-hover:bg-black/45"
							data-open-fullscreen
							data-video-target="video-featured"
							aria-label={`Abrir ${featuredVideo.title} en pantalla completa`}
						>
							<span class="rounded-full border border-white/30 bg-black/40 px-4 py-2 backdrop-blur">Reproducir en pantalla completa</span>
						</button>
					</div>
				</article>
				<div class="rounded-4xl border border-white/10 bg-white/5 p-6 lg:col-span-4">
					<p class="text-xs font-semibold uppercase tracking-[0.35em] text-white/45">Destacado</p>
					<h2 class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">{featuredVideo.title}</h2>
					<p class="mt-4 text-sm leading-7 text-white/68">
						Video promocional para Benigna en formato vertical, Duitama. 
					</p>
				</div>
			</div>
		) : (
			<div class="rounded-3xl border border-white/10 bg-white/5 p-8 text-sm text-white/60">
				No encontramos videos.
			</div>
		)}
	</section>

	<section class="mx-auto max-w-7xl px-6 pb-24 sm:px-10 lg:px-12" data-reveal-item>
		<div class="flex items-end justify-between gap-8 border-b border-white/10 pb-8">
			<div>
				<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Galería</p>
				<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Todos los videos.</h2>
			</div>
			<p class="hidden max-w-xl text-sm leading-7 text-white/55 md:block">
				Da click en el video que quieras ver para abrirlo en pantalla completa.
			</p>
		</div>

		{secondaryVideos.length > 0 ? (
			<div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
				{secondaryVideos.map((video, index) => (
					<article class="overflow-hidden rounded-3xl border border-white/10 bg-white/5">
						<div class="border-b border-white/10 px-5 py-4">
							<p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/45">Video - {video.category}</p>
							<h3 class="mt-2 text-lg font-semibold">{video.title}</h3>
						</div>
						<div class="group relative">
							<video
								id={`video-grid-${index}`}
								class="aspect-video w-full object-cover"
								preload="metadata"
								playsinline
								aria-label={video.title}
								data-fullscreen-video
							>
								<source src={video.src} type={video.type} />
								Tu navegador no soporta video HTML5.
							</video>
							<button
								type="button"
								class="absolute inset-0 z-10 flex items-center justify-center bg-black/30 p-4 text-center text-xs font-semibold text-white/90 transition group-hover:bg-black/45"
								data-open-fullscreen
								data-video-target={`video-grid-${index}`}
								aria-label={`Abrir ${video.title} en pantalla completa`}
							>
								<span class="rounded-full border border-white/30 bg-black/40 px-3 py-2 backdrop-blur">Pantalla completa</span>
							</button>
						</div>
					</article>
				))}
			</div>
		) : (
			<div class="mt-10 rounded-3xl border border-white/10 bg-white/5 p-8 text-sm text-white/60">
				No hay más videos para mostrar todavía.
			</div>
		)}
	</section>
    <footer class="border-t border-white/10 bg-slate-950">
			<div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 sm:px-10 lg:grid-cols-12 lg:px-12">
				<div class="lg:col-span-5">
					<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Vizualy.Studio</p>
					<p class="mt-4 max-w-md text-sm leading-7 text-white/65">
						Fotografía y video con intención, estética y emoción para marcas, bodas y experiencias.
					</p>
				</div>
				<div class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3">
					<div>
						<p class="text-sm font-semibold text-white">Ubicación</p>
						<p class="mt-3 text-sm leading-7 text-white/65">Duitama, Boyacá, Colombia</p>
					</div>
					<div>
						<p class="text-sm font-semibold text-white">Contacto</p>
						<div class="mt-3 space-y-2 text-sm leading-7 text-white/65">
							<a href="https://wa.me/573209383582?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener noreferrer" class="block transition hover:text-white">+57 320 938 3582</a>
							<a href="mailto:vizualy.studio@gmail.com" class="block transition hover:text-white">vizualy.studio@gmail.com</a>
						</div>
					</div>
					<div>
						<p class="text-sm font-semibold text-white">Redes</p>
						<div class="mt-3 space-y-2 text-sm leading-7 text-white/65">
							<a href="https://instagram.com/vizualy.studio" target="_blank" rel="noopener noreferrer" class="block transition hover:text-white">Instagram</a>
						</div>
					</div>
				</div>
				<div class="lg:col-span-12">
					<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/45 sm:flex-row sm:items-center sm:justify-between">
						<p>© 2026 Luis Ruge. Todos los derechos reservados.</p>
						<p>Hecho con foco en imagen, ritmo y claridad.</p>
					</div>
				</div>
			</div>
		</footer>
</WorkLayout>

<style>
	[data-fullscreen-video] {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: #020617;
	}

	[data-fullscreen-video]:fullscreen,
	[data-fullscreen-video]:-webkit-full-screen {
		width: 100vw;
		height: 100vh;
		aspect-ratio: auto;
		object-fit: contain;
		background: #000;
	}
</style>

<script>
	const fullscreenButtons = document.querySelectorAll<HTMLButtonElement>('[data-open-fullscreen]');
	const fullscreenVideos = document.querySelectorAll<HTMLVideoElement>('[data-fullscreen-video]');

	const isVideoFullscreen = (video: HTMLVideoElement) => {
		const fullscreenElement = document.fullscreenElement as HTMLElement | null;
		const webkitElement = (document as Document & { webkitFullscreenElement?: Element }).webkitFullscreenElement as HTMLElement | null;

		return fullscreenElement === video || webkitElement === video || (video as HTMLVideoElement & { webkitDisplayingFullscreen?: boolean }).webkitDisplayingFullscreen === true;
	};

	const closeInlinePlayback = (video: HTMLVideoElement) => {
		if (isVideoFullscreen(video)) {
			return;
		}

		video.pause();
		video.controls = false;
	};

	const openFullscreenPlayback = async (video: HTMLVideoElement) => {
		video.controls = true;

		try {
			if (video.requestFullscreen) {
				await video.requestFullscreen();
			} else if ((video as HTMLVideoElement & { webkitRequestFullscreen?: () => Promise<void> }).webkitRequestFullscreen) {
				await (video as HTMLVideoElement & { webkitRequestFullscreen: () => Promise<void> }).webkitRequestFullscreen();
			} else if ((video as HTMLVideoElement & { webkitEnterFullscreen?: () => void }).webkitEnterFullscreen) {
				(video as HTMLVideoElement & { webkitEnterFullscreen: () => void }).webkitEnterFullscreen();
			}
		} catch {
			// Ignore fullscreen errors and still try to play.
		}

		try {
			await video.play();
		} catch {
			video.controls = true;
		}
	};

	fullscreenVideos.forEach((video) => {
		video.controls = false;
		video.addEventListener('pause', () => closeInlinePlayback(video));
		video.addEventListener('ended', () => closeInlinePlayback(video));
		video.addEventListener('webkitendfullscreen', () => closeInlinePlayback(video));
	});

	fullscreenButtons.forEach((button) => {
		button.addEventListener('click', () => {
			const targetId = button.dataset.videoTarget;
			if (!targetId) {
				return;
			}

			const targetVideo = document.getElementById(targetId);
			if (!(targetVideo instanceof HTMLVideoElement)) {
				return;
			}

			openFullscreenPlayback(targetVideo);
		});
	});

	document.addEventListener('fullscreenchange', () => {
		fullscreenVideos.forEach((video) => {
			if (!isVideoFullscreen(video)) {
				closeInlinePlayback(video);
			}
		});
	});
</script>