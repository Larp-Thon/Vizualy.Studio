---
import WorkLayout from '../../layouts/WorkLayout.astro';

const images = import.meta.glob('/public/bodas/*.{jpg,JPG,webp}', { eager: true });
const bodaImages = Object.entries(images)
  .map(([path, module]) => {
    const filename = path.split('/').pop() || '';
    return {
      src: `/bodas/${filename}`,
      alt: filename.replace(/\.(jpg|JPG|webp)$/i, ''),
    };
  })
  .sort((a, b) => a.alt.localeCompare(b.alt, 'es'));
---

<WorkLayout
  title="Bodas - Vizualy.Studio"
  heroImage="/bodas/bodaportada.png"
  heroAlt="Sesión de boda"
  heroText="Bodas"
  heroSubtext="Cada boda es un viaje emocional único. Nuestro trabajo es capturar esos momentos que definen tu día: la complicidad, la alegría, la ternura. Fotos que trascienden el tiempo."
>
  <!-- Galería de Imágenes -->
  <section class="mx-auto max-w-8xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="columns-1 sm:columns-2 md:columns-3 lg:columns-4 xl:columns-5" style="column-gap:0.5rem">
      {bodaImages.map((img, index) => (
        <button
          type="button"
          class="group relative mb-3 block w-full cursor-zoom-in overflow-hidden rounded-2xl bg-white/5 text-left outline-none ring-0 transition focus-visible:ring-2 focus-visible:ring-white/70"
          style="break-inside: avoid; -webkit-column-break-inside: avoid; page-break-inside: avoid;"
          data-index={index}
          data-reveal-item
          data-lightbox-src={img.src}
          aria-label={`Abrir imagen ${img.alt}`}
        >
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto rounded-2xl object-cover transition duration-500 group-hover:scale-110"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-300"></div>
        </button>
      ))}
    </div>
  </section>

  <!-- CTA Final -->
  <section class="mx-auto max-w-7xl px-6 py-20 sm:px-10 lg:px-12 border-t border-white/10">
    <div class="text-center">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">¿Te gustaría que capturemos tu momento?</h2>
      <p class="mt-4 text-white/60 max-w-2xl mx-auto">Hablemos sobre tu visión y hagamos que tu día sea inolvidable.</p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a
          href="https://wa.me/573209383582?text=Hola%2C%20me%20interes%C3%B3%20en%20los%20servicios%20para%20bodas"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-white px-8 py-3 text-sm font-semibold text-slate-950 transition hover:bg-white/90"
        >
          Hablemos por WhatsApp
        </a>
        <a
          href="/"
          class="rounded-full border border-white/25 bg-white/10 px-8 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</WorkLayout>
