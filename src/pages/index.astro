---
import BaseLayout from '../layouts/BaseLayout.astro';

const businessLogoEntries = import.meta.glob('/public/empresas/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}', { eager: true });

const businessLogos = Object.keys(businessLogoEntries)
	.map((path) => {
		const filename = path.split('/').pop() || '';

		return {
			src: path.replace('/public', ''),
			alt: filename.replace(/\.[^.]+$/, '').replace(/[_.-]+/g, ' ').trim(),
		};
	})
	.sort((a, b) => a.alt.localeCompare(b.alt, 'es'));
---

