---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vizualy.Studio">
	<main class="bg-slate-950 text-white">
		<section class="relative min-h-screen overflow-hidden">
			<img
				src="/bodas/lilo.webp"
				alt="Fotógrafo trabajando en una sesión editorial"
				class="absolute inset-0 h-full w-full object-cover"
				loading="eager"
				draggable="false"
			/>
			<div class="absolute inset-0 bg-linear-to-b from-black/35 via-black/40 to-slate-950"></div>

			<header class="absolute left-0 right-0 top-0 z-20">
				<div class="mx-auto grid max-w-7xl grid-cols-1 items-center px-6 py-6 sm:px-10 lg:grid-cols-[1fr_auto_1fr] lg:px-12">
					<button
						id="mobile-menu-btn"
						class="lg:hidden flex items-center justify-start"
						aria-label="Abrir menú"
						onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
					>
						<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</button>
					<nav class="hidden items-center gap-10 text-sm text-white/80 lg:flex lg:justify-self-end lg:pr-12">
						<div class="group relative">
							<button class="transition hover:text-white flex items-center gap-1">
								Fotografías
								<svg class="w-4 h-4 transition group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
								</svg>
							</button>
							<div class="absolute left-0 mt-0 w-48 bg-slate-900/95 border border-white/10 rounded-lg shadow-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 py-2 z-50">
								<a href="/trabajos/bodas" class="block px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/5 transition">Bodas</a>
								<a href="/trabajos/quinceanos" class="block px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/5 transition">Quinceaños</a>
								<a href="/trabajos/bautizos" class="block px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/5 transition">Bautizos</a>
								<a href="/trabajos/empresariales" class="block px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/5 transition">Empresariales</a>
								<a href="/trabajos/sesiones" class="block px-4 py-2 text-sm text-white/80 hover:text-white hover:bg-white/5 transition">Sesiones de fotos</a>
							</div>
						</div>
						<a href="#videos" class="transition hover:text-white">Videos</a>
					</nav>
					<a href="#inicio" class="mx-auto text-sm font-semibold uppercase tracking-[0.45em] text-white/95 transition hover:text-white lg:justify-self-center">Vizualy</a>
					<nav class="hidden items-center gap-10 text-sm text-white/80 lg:flex lg:justify-self-start lg:pl-12">
						<a href="https://wa.me/573209383582?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener noreferrer" class="transition hover:text-white">Conocer tarifas</a>
						<a href="#preguntas-frecuentes" class="transition hover:text-white">Preguntas frecuentes</a>
					</nav>
				</div>
			<nav
				id="mobile-menu"
				class="hidden lg:hidden bg-black/95 border-t border-white/10 px-6 py-4 sm:px-10 space-y-3"
			>
				<div class="space-y-2">
					<button
						id="mobile-fotos-toggle"
						class="w-full text-left block text-sm text-white/80 transition hover:text-white py-2 flex items-center justify-between"
						onclick="document.getElementById('mobile-fotos-submenu').classList.toggle('hidden'); document.getElementById('mobile-fotos-icon').classList.toggle('rotate-180')"
					>
						Fotografías
						<svg class="w-4 h-4 transition" id="mobile-fotos-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
						</svg>
					</button>
					<div id="mobile-fotos-submenu" class="hidden space-y-1 pl-4 border-l border-white/10">
						<a
							href="/trabajos/bodas"
							class="block text-sm text-white/60 transition hover:text-white py-2"
							onclick="document.getElementById('mobile-menu').classList.add('hidden')"
						>
							Bodas
						</a>
						<a
							href="/trabajos/quinceanos"
							class="block text-sm text-white/60 transition hover:text-white py-2"
							onclick="document.getElementById('mobile-menu').classList.add('hidden')"
						>
							Quinceaños
						</a>
						<a
							href="/trabajos/bautizos"
							class="block text-sm text-white/60 transition hover:text-white py-2"
							onclick="document.getElementById('mobile-menu').classList.add('hidden')"
						>
							Bautizos
						</a>
						<a
							href="/trabajos/empresariales"
							class="block text-sm text-white/60 transition hover:text-white py-2"
							onclick="document.getElementById('mobile-menu').classList.add('hidden')"
						>
							Empresariales
						</a>
						<a
							href="/trabajos/sesiones"
							class="block text-sm text-white/60 transition hover:text-white py-2"
							onclick="document.getElementById('mobile-menu').classList.add('hidden')"
						>
							Sesiones de fotos
						</a>
					</div>
				</div>
				<a
					href="#videos"
					class="block text-sm text-white/80 transition hover:text-white py-2"
					onclick="document.getElementById('mobile-menu').classList.add('hidden')"
				>
					Videos
				</a>
				<a
					href="https://wa.me/573209383582?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios."
					target="_blank"
					rel="noopener noreferrer"
					class="block text-sm text-white/80 transition hover:text-white py-2"
				>
					Conocer tarifas
				</a>
				<a
					href="#preguntas-frecuentes"
					class="block text-sm text-white/80 transition hover:text-white py-2"
					onclick="document.getElementById('mobile-menu').classList.add('hidden')"
				>
					Preguntas frecuentes
				</a>
			</nav>
			</header>

			<div id="inicio" class="relative z-10 mx-auto flex min-h-screen max-w-7xl items-end px-6 py-12 sm:px-10 sm:py-16 lg:px-12">
				<div class="max-w-3xl">
					<p class="text-xs font-semibold uppercase tracking-[0.5em] text-white/70">Fotógrafos y Filmakers</p>
					<h1 class="mt-6 text-4xl font-black tracking-tight text-white sm:text-7xl lg:text-7xl">
						Creamos recuerdos que no se olvidan, se reviven.
					</h1>
					<p class="mt-6 max-w-2xl text-base leading-8 text-white/80 sm:text-lg">
						En Vizualy.studio creamos contenido visual para marcas, bodas y experiencias: Fotografía y video con intención, estética y emoción.
					</p>
					<div class="mt-10 flex flex-wrap gap-4">
						<a href="#trabajos" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-white/90">Ver trabajos</a>
						<a href="https://wa.me/573209383582?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/15">Hablemos</a>
					</div>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-7xl px-6 py-24 sm:px-10 lg:px-12">
			<div class="grid gap-10 lg:grid-cols-12 lg:items-center">
				<div class="lg:col-span-5">
					<div class="aspect-4/5 overflow-hidden rounded-4xl border border-white/10 bg-white/5 shadow-2xl shadow-black/30">
						<img
							src="https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=1400&q=80"
							alt="El equipo de Vizualy"
							class="h-full w-full object-cover"
							loading="lazy"
							draggable="false"
						/>
					</div>
				</div>
				<div class="lg:col-span-7 lg:pl-8">
					<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Sobre nosotros</p>
					<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Fotógrafos que construyen identidad visual con calma, criterio y detalle.</h2>
					<p class="mt-6 max-w-2xl text-base leading-8 text-white/72 sm:text-lg">
						En Vizualy acompañamos a marcas y personas que necesitan imágenes con una presencia clara, estética cuidada y un lenguaje coherente en toda su comunicación.
					</p>
					<p class="mt-5 max-w-2xl text-base leading-8 text-white/72 sm:text-lg">
						Nuestro trabajo combina dirección de arte, fotografía y edición para que cada entrega se sienta editorial, humana y atemporal.
					</p>
					<div class="mt-8 grid gap-4 sm:grid-cols-3">
						<div class="rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm font-semibold text-white">Dirección</p>
							<p class="mt-2 text-sm leading-6 text-white/60">Alineamos la sesión con la identidad de cada cliente.</p>
						</div>
						<div class="rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm font-semibold text-white">Estética</p>
							<p class="mt-2 text-sm leading-6 text-white/60">Buscamos una imagen limpia, elegante y memorable.</p>
						</div>
						<div class="rounded-3xl border border-white/10 bg-white/5 p-5">
							<p class="text-sm font-semibold text-white">Entrega</p>
							<p class="mt-2 text-sm leading-6 text-white/60">Pensamos en el cliente o la campaña y valoramos su tiempo desde el inicio.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="trabajos" class="mx-auto max-w-7xl px-6 pt-24 pb-6 sm:px-10 lg:px-12">
			<div class="flex items-end justify-between gap-8 border-b border-white/10 pb-8">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Trabajos recientes</p>
					<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Las fotografías de tus sueños.</h2>
				</div>
				<p class="hidden max-w-xl text-sm leading-7 text-white/55 md:block">
					Cada fotografía se diseña para que la dirección de arte, la composición y el color trabajen juntas.
				</p>
			</div>

			<div class="mt-10 grid gap-6 lg:grid-cols-12">
				<article class="group relative h-85 overflow-hidden rounded-4xl lg:col-span-7 lg:h-105">
					<img src="/quinces/jpg.webp" alt="Sesión fotográfica de moda" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
					<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
					<div class="absolute bottom-0 left-0 right-0 p-8">
						<p class="text-xs font-semibold uppercase tracking-[0.4em] text-white/60">Quinceaños / Ráquira</p>
						<h3 class="mt-3 text-2xl font-semibold">"La mejor experiencia de mi vida"</h3>
					</div>
				</article>
				<article class="group relative h-85 overflow-hidden rounded-4xl lg:col-span-5 lg:h-105">
					<img src="/bautizos/bautizo1.webp" alt="Retrato creativo en estudio" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" />
					<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
					<div class="absolute bottom-0 left-0 right-0 p-8">
						<p class="text-xs font-semibold uppercase tracking-[0.4em] text-white/60">Bautizo / Duitama</p>
						<h3 class="mt-3 text-2xl font-semibold">"Las fotos son excelentes"</h3>
					</div>
				</article>
				<div class="lg:col-span-12 mt-3 mb-9 flex justify-end">
					<a href="/trabajos/bodas" class="inline-flex items-center px-12 py-2 text-sm font-semibold text-white/45 transition hover:underline">Ver más fotos --></a>
				</div>
			</div>
		</section>

		<section id="videos" class="mx-auto mb-12 max-w-7xl px-6 sm:px-10 lg:px-12">
			<div class="flex items-end justify-between gap-8 border-b border-white/10 pb-8">
				<div>
					<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Los videos que tanto quisiste.</h2>
				</div>
				<p class="hidden max-w-xl text-sm leading-7 text-white/55 md:block">
					Cada vídeo tiene una dirección y alma para sentir el momento.
				</p>
			</div>

			<div class="mt-10 grid gap-6 lg:grid-cols-12">
				<article class="group relative h-85 overflow-hidden rounded-4xl lg:col-span-5 lg:h-105">
					<iframe
						class="absolute left-1/2 top-1/2 h-full w-[177.78%] -translate-x-1/2 -translate-y-1/2 transition duration-700 group-hover:scale-105"
						src="https://www.youtube.com/embed/MVLwNOnMs9c?autoplay=1&mute=1&loop=1&playlist=MVLwNOnMs9c&controls=0&modestbranding=1&rel=0&playsinline=1&fs=0&disablekb=1&iv_load_policy=3"
						title="Video de boda en exteriores"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
					<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
					<div class="absolute bottom-0 left-0 right-0 p-8">
						<p class="text-xs font-semibold uppercase tracking-[0.4em] text-white/60">Boda / Ráquira</p>
						<h3 class="mt-3 text-2xl font-semibold">"Maravilloso ambiente."</h3>
					</div>
				</article>
				<article class="group relative h-85 overflow-hidden rounded-4xl lg:col-span-7 lg:h-105">
					<iframe
						class="absolute left-1/2 top-1/2 h-full w-[177.78%] -translate-x-1/2 -translate-y-1/2 transition duration-700 group-hover:scale-105"
						src="https://www.youtube.com/embed/IgfsWyWfzGM?autoplay=1&mute=1&loop=1&playlist=IgfsWyWfzGM&controls=0&modestbranding=1&rel=0&playsinline=1&fs=0&disablekb=1&iv_load_policy=3"
						title="Video de boda en exteriores"
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					></iframe>
					<div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent"></div>
					<div class="absolute bottom-0 left-0 right-0 p-8">
						<p class="text-xs font-semibold uppercase tracking-[0.4em] text-white/60">Bautizo / Duitama</p>
						<h3 class="mt-3 text-2xl font-semibold">"Muy buen video, siguieron todas las indicaciones."</h3>
					</div>
				</article>
				<div class="lg:col-span-12 mt-3 flex justify-end">
					<a href="/videos" class="inline-flex items-center px-12 pb-2 text-sm font-semibold text-white/45 transition hover:underline">Ver todos los videos --></a>
				</div>
			</div>
		</section>

		<section id="preguntas-frecuentes" class="mx-auto max-w-7xl px-6 py-20 sm:px-10 lg:px-12">
			<div class="flex items-end justify-between gap-8 border-b border-white/10 pb-8">
				<div>
					<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Preguntas frecuentes</p>
					<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Lo que suelen preguntar antes de reservar.</h2>
				</div>
				<p class="hidden max-w-xl text-sm leading-7 text-white/55 md:block">
					Respuestas claras para resolver rápido dudas sobre tiempos, entregas y forma de trabajo.
				</p>
			</div>

			<div class="mt-10 grid gap-4">
				<details class="group rounded-4xl border border-white/10 bg-white/5 p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-white">
						<span>¿Con cuánta anticipación debemos reservar?</span>
						<span class="text-white/45 transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-white/65">
						Idealmente con varias semanas de anticipación, especialmente si es una boda o una producción con fecha fija. Así podemos organizar mejor la preproducción y asegurar disponibilidad.
					</p>
				</details>

				<details class="group rounded-4xl border border-white/10 bg-white/5 p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-white">
						<span>¿Entregan fotografías y video editados?</span>
						<span class="text-white/45 transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-white/65">
						Sí. Entregamos el material seleccionado y editado según el tipo de proyecto.
					</p>
				</details>

				<details class="group rounded-4xl border border-white/10 bg-white/5 p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-white">
						<span>¿Trabajan solo en bodas?</span>
						<span class="text-white/45 transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-white/65">
						No. También trabajamos en bautizos, campañas, contenido para marcas, quinceaños o redes.
					</p>
				</details>

				<details class="group rounded-4xl border border-white/10 bg-white/5 p-6">
					<summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-white">
						<span>¿Pueden ayudarnos a definir la dirección visual?</span>
						<span class="text-white/45 transition group-open:rotate-45">+</span>
					</summary>
					<p class="mt-4 max-w-3xl text-sm leading-7 text-white/65">
						Sí. De hecho, parte del proceso es definir la estética, el mood y el ritmo visual para que todo quede alineado antes de tomar la foto.
					</p>
				</details>
			</div>
		</section>

		<section id="contacto" class="mx-auto max-w-7xl px-6 pb-24 sm:px-10 lg:px-12">
			<div class="rounded-4xl border border-white/10 bg-linear-to-br from-white/10 to-white/3 p-10 sm:p-14">
				<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Contacto</p>
				<div class="mt-6 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
					<div class="max-w-2xl">
						<h2 class="text-3xl font-semibold tracking-tight sm:text-5xl">Si tienes alguna idea en mente, ya sabes a quién contactar.</h2>
					</div>
					<a href="mailto:hola@visually.studio" class="inline-flex w-fit rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-white/90">hola@visually.studio</a>
				</div>
			</div>
		</section>

		<footer class="border-t border-white/10 bg-slate-950">
			<div class="mx-auto grid max-w-7xl gap-10 px-6 py-14 sm:px-10 lg:grid-cols-12 lg:px-12">
				<div class="lg:col-span-5">
					<p class="text-xs font-semibold uppercase tracking-[0.45em] text-white/45">Vizualy.Studio</p>
					<p class="mt-4 max-w-md text-sm leading-7 text-white/65">
						Fotografía y video con intención, estética y emoción para marcas, bodas y experiencias.
					</p>
				</div>
				<div class="grid gap-8 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-3">
					<div>
						<p class="text-sm font-semibold text-white">Ubicación</p>
						<p class="mt-3 text-sm leading-7 text-white/65">Duitama, Boyacá, Colombia</p>
					</div>
					<div>
						<p class="text-sm font-semibold text-white">Contacto</p>
						<div class="mt-3 space-y-2 text-sm leading-7 text-white/65">
							<a href="https://wa.me/573209383582?text=Hola%2C%20quisiera%20informaci%C3%B3n%20sobre%20sus%20servicios." target="_blank" rel="noopener noreferrer" class="block transition hover:text-white">+57 320 938 3582</a>
							<a href="mailto:hola@visually.studio" class="block transition hover:text-white">hola@visually.studio</a>
						</div>
					</div>
					<div>
						<p class="text-sm font-semibold text-white">Redes</p>
						<div class="mt-3 space-y-2 text-sm leading-7 text-white/65">
							<a href="https://instagram.com/vizualy.studio" target="_blank" rel="noopener noreferrer" class="block transition hover:text-white">Instagram</a>
						</div>
					</div>
				</div>
				<div class="lg:col-span-12">
					<div class="mt-6 flex flex-col gap-3 border-t border-white/10 pt-6 text-sm text-white/45 sm:flex-row sm:items-center sm:justify-between">
						<p>© 2026 Luis Ruge. Todos los derechos reservados.</p>
						<p>Hecho con foco en imagen, ritmo y claridad.</p>
					</div>
				</div>
			</div>
		</footer>
	</main>
</BaseLayout>
